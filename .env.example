# Copy to `.env`, fill in real values, and NEVER commit `.env` (gitignored).
# Load into your shell before running dbt, e.g.:
#   set -a && source .env && set +a

# Workspace hostname — no "https://", no trailing slash.
# Databricks UI -> SQL Warehouses -> your warehouse -> Connection details -> Server hostname
DBT_DATABRICKS_HOST=adb-1234567890123456.7.azuredatabricks.net

# HTTP Path for the SQL Warehouse.
# Same "Connection details" tab -> HTTP path
DBT_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abcdef1234567890

# Personal Access Token.
# Databricks UI -> user menu (top right) -> Settings -> Developer -> Access tokens -> Generate new token
DBT_DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Unity Catalog catalog name for this environment (dev vs prod)
DBT_DATABRICKS_CATALOG=dev

# Fallback schema (layer schemas are set per-model via +schema config)
DBT_DATABRICKS_SCHEMA=default

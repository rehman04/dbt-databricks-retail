# Copy this file to `profiles.yml` (repo root) and never commit that copy —
# it's already covered by .gitignore. Populate the actual values via a `.env`
# file (see .env.example) rather than typing them in here.
#
# The top-level key MUST match `profile:` in dbt_project.yml.
dbt_databricks_retail:

  # Which output block below is used when you don't pass --target explicitly.
  target: dev

  outputs:

    dev:
      type: databricks              # tells dbt to use the dbt-databricks adapter

      # --- Unity Catalog three-level namespace ---
      # catalog: the top-level container. We use it to separate environments
      #          (dev vs prod), rather than duplicating schemas per env.
      #          Find it in Databricks UI: left sidebar -> "Catalog" -> the
      #          catalog name shown at the top of the tree (or `SHOW CATALOGS`).
      catalog: "{{ env_var('DBT_DATABRICKS_CATALOG', 'dev') }}"

      # schema: fallback schema if a model doesn't set +schema itself.
      #         In this project every model sets +schema explicitly
      #         (bronze/silver/gold, via generate_schema_name.sql), so this
      #         is mostly a safety default.
      schema: "{{ env_var('DBT_DATABRICKS_SCHEMA', 'default') }}"

      # host: your Databricks workspace URL — NO "https://" prefix, no
      #       trailing slash. Find it: SQL Warehouses -> click your warehouse
      #       -> "Connection details" tab -> "Server hostname".
      host: "{{ env_var('DBT_DATABRICKS_HOST') }}"

      # http_path: identifies the specific SQL Warehouse (or cluster) to run
      #            queries against. Same "Connection details" tab -> "HTTP path".
      #            Looks like: /sql/1.0/warehouses/0123456789abcdef
      http_path: "{{ env_var('DBT_DATABRICKS_HTTP_PATH') }}"

      # token: a Personal Access Token (PAT) — Databricks UI -> click your
      #        username (top right) -> Settings -> Developer -> Access tokens
      #        -> Generate new token. Treat it like a password.
      token: "{{ env_var('DBT_DATABRICKS_TOKEN') }}"

      # threads: how many models dbt is allowed to build concurrently,
      #          while still respecting DAG order. Not a Databricks concept —
      #          purely how parallel dbt's own execution is.
      threads: 4

    prod:
      type: databricks
      catalog: "{{ env_var('DBT_DATABRICKS_CATALOG', 'prod') }}"
      schema: "{{ env_var('DBT_DATABRICKS_SCHEMA', 'default') }}"
      host: "{{ env_var('DBT_DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DBT_DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DBT_DATABRICKS_TOKEN') }}"
      threads: 8
